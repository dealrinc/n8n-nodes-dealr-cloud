{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": false,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["credentials/**/*.ts", "nodes/**/*.ts", "generated/*.json"]
}
